# Preserve exact measured artifact bytes so manifest SHA256 values survive checkout.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib emits cosmetic spaces in multiline SVG path data; keep its bytes exact.
*.svg -text -whitespace
