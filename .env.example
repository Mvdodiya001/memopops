# Local development only. Replace before starting FalkorDB.
FALKORDB_IMAGE=falkordb/falkordb-server:v4.22.0
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=replace-with-a-long-random-local-password
FALKORDB_SSL=false
MEMOPOPS_AUTH_TOKENS='{"local-reader-token":{"workspace_id":"workspace_demo","role":"reader"},"local-writer-token":{"workspace_id":"workspace_demo","role":"writer"},"local-operator-token":{"workspace_id":"workspace_demo","role":"operator"}}'

# Optional live model. Keep these empty in this example.
# Copy this file to the gitignored .env and paste a Google AI Studio key there:
# MEMOPOPS_MODEL_API_KEY=YOUR_KEY_HERE
# An empty base URL and model name select Gemini Flash (gemini-flash-latest).
# The client POSTs to
# https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
# with header X-goog-api-key. It does not call /chat/completions.
# Scripted replay stays the default when the key is absent.
MEMOPOPS_MODEL_API_KEY=
MEMOPOPS_MODEL_BASE_URL=
MEMOPOPS_MODEL_NAME=
